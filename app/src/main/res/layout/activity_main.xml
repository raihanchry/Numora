<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="14dp"
    tools:context=".MainActivity">

    <!-- Reference-Matched Minimal 5-Icon Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. Scientific Expand Toggle -->
        <ImageButton
            android:id="@+id/btnToggleScientific"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mode_scientific"
            android:src="@drawable/ic_expand_scientific" />

        <!-- 2. Calculator Tab -->
        <ImageButton
            android:id="@+id/btnTabCalculator"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tab_calculator"
            android:src="@drawable/ic_tab_calc" />

        <!-- 3. Unit Converter Tab -->
        <ImageButton
            android:id="@+id/btnTabConverter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tab_converter"
            android:src="@drawable/ic_tab_unit" />

        <!-- 4. Age Calculator Tab -->
        <ImageButton
            android:id="@+id/btnTabAge"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tab_age"
            android:src="@drawable/ic_tab_age" />

        <!-- 5. Light / Dark Contrast Theme Toggle -->
        <ImageButton
            android:id="@+id/btnToggleTheme"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_toggle_theme"
            android:src="@drawable/ic_contrast_theme" />
    </LinearLayout>

    <!-- Multi-Tool Content Switcher -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: Basic & Scientific Calculator Workspace -->
        <LinearLayout
            android:id="@+id/calculatorWorkspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Seamless Display Area with Inline History Tape -->
            <LinearLayout
                android:id="@+id/displayArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:gravity="bottom"
                android:minHeight="130dp"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:paddingBottom="10dp">

                <!-- Subtle Scientific Status & Copy Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAngleMode"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_badge_chip"
                        android:clickable="true"
                        android:contentDescription="@string/cd_toggle_angle"
                        android:focusable="true"
                        android:fontFamily="@font/jetbrains_mono"
                        android:gravity="center"
                        android:minWidth="44dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/angle_deg"
                        android:textColor="@color/badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chipInverseBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_chip"
                        android:fontFamily="@font/jetbrains_mono"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/badge_inv"
                        android:textColor="@color/text_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnCopyResult"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_copy_result"
                        android:src="@drawable/ic_copy"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Live Inline History Tape -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvInlineHistory"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:fadingEdgeLength="24dp"
                    android:overScrollMode="never"
                    android:paddingTop="2dp"
                    android:paddingBottom="6dp"
                    android:requiresFadingEdge="vertical" />

                <!-- Active Expression Line (e.g. 285 ÷ 7) -->
                <HorizontalScrollView
                    android:id="@+id/hsvExpression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/tvExpression"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="end|center_vertical"
                        android:maxLines="1"
                        android:minHeight="32dp"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="285 ÷ 7" />
                </HorizontalScrollView>

                <!-- Large Bold Primary Result Line (e.g. = 40.7143857) -->
                <TextView
                    android:id="@+id/tvPrimaryResult"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:contentDescription="@string/cd_copy_result"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="end|center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="38sp"
                    app:autoSizeMinTextSize="18sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    tools:text="= 40.7143857" />
            </LinearLayout>

            <!-- Crisp Subtle Divider Between Display and Keypad -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:background="@color/divider_subtle" />

            <!-- Collapsible 2-Row Scientific Function Strip -->
            <LinearLayout
                android:id="@+id/scientificKeypadContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInv"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_inv"
                        android:minHeight="44dp"
                        android:text="2nd" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSin"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_sin"
                        android:minHeight="44dp"
                        android:text="sin" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCos"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_cos"
                        android:minHeight="44dp"
                        android:text="cos" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTan"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_tan"
                        android:minHeight="44dp"
                        android:text="tan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPower"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_power"
                        android:minHeight="44dp"
                        android:text="xʸ"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLog"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_log"
                        android:minHeight="44dp"
                        android:text="log" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLn"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_ln"
                        android:minHeight="44dp"
                        android:text="ln" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPi"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_pi"
                        android:minHeight="44dp"
                        android:text="π"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEuler"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_euler"
                        android:minHeight="44dp"
                        android:text="e"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFactorial"
                        style="@style/Widget.Calco.Key.Scientific"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_factorial"
                        android:minHeight="44dp"
                        android:text="n!" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pixel-Aligned 6x4 Reference Keypad with Tall 2-Row Equals Key -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/basicKeypadContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.55">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/vGuide1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.25" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/vGuide2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.50" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/vGuide3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.75" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/hGuide1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.1667" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/hGuide2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.3333" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/hGuide3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.5000" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/hGuide4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.6667" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/hGuide5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.8333" />

                <!-- Row 1: C, (, ), × -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    style="@style/Widget.Calco.Key.Clear"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_clear_all"
                    android:text="C"
                    app:layout_constraintBottom_toTopOf="@id/hGuide1"
                    app:layout_constraintEnd_toStartOf="@id/vGuide1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenParen"
                    style="@style/Widget.Calco.Key.Func"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_open_paren"
                    android:text="("
                    app:layout_constraintBottom_toTopOf="@id/hGuide1"
                    app:layout_constraintEnd_toStartOf="@id/vGuide2"
                    app:layout_constraintStart_toEndOf="@id/vGuide1"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseParen"
                    style="@style/Widget.Calco.Key.Func"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_close_paren"
                    android:text=")"
                    app:layout_constraintBottom_toTopOf="@id/hGuide1"
                    app:layout_constraintEnd_toStartOf="@id/vGuide3"
                    app:layout_constraintStart_toEndOf="@id/vGuide2"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMultiply"
                    style="@style/Widget.Calco.Key.Operator"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_multiply"
                    android:text="×"
                    app:layout_constraintBottom_toTopOf="@id/hGuide1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vGuide3"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Row 2: √, %, ⌫, ÷ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSqrt"
                    style="@style/Widget.Calco.Key.Func"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_sqrt"
                    android:text="√"
                    app:layout_constraintBottom_toTopOf="@id/hGuide2"
                    app:layout_constraintEnd_toStartOf="@id/vGuide1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/hGuide1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPercent"
                    style="@style/Widget.Calco.Key.Func"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_percent"
                    android:text="%"
                    app:layout_constraintBottom_toTopOf="@id/hGuide2"
                    app:layout_constraintEnd_toStartOf="@id/vGuide2"
                    app:layout_constraintStart_toEndOf="@id/vGuide1"
                    app:layout_constraintTop_toBottomOf="@id/hGuide1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackspace"
                    style="@style/Widget.Calco.Key.Func"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_backspace"
                    app:icon="@drawable/ic_backspace"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/key_func_text"
                    app:layout_constraintBottom_toTopOf="@id/hGuide2"
                    app:layout_constraintEnd_toStartOf="@id/vGuide3"
                    app:layout_constraintStart_toEndOf="@id/vGuide2"
                    app:layout_constraintTop_toBottomOf="@id/hGuide1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDivide"
                    style="@style/Widget.Calco.Key.Operator"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_divide"
                    android:text="÷"
                    app:layout_constraintBottom_toTopOf="@id/hGuide2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vGuide3"
                    app:layout_constraintTop_toBottomOf="@id/hGuide1" />

                <!-- Row 3: 7, 8, 9, − -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn7"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="7"
                    app:layout_constraintBottom_toTopOf="@id/hGuide3"
                    app:layout_constraintEnd_toStartOf="@id/vGuide1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/hGuide2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn8"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="8"
                    app:layout_constraintBottom_toTopOf="@id/hGuide3"
                    app:layout_constraintEnd_toStartOf="@id/vGuide2"
                    app:layout_constraintStart_toEndOf="@id/vGuide1"
                    app:layout_constraintTop_toBottomOf="@id/hGuide2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn9"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="9"
                    app:layout_constraintBottom_toTopOf="@id/hGuide3"
                    app:layout_constraintEnd_toStartOf="@id/vGuide3"
                    app:layout_constraintStart_toEndOf="@id/vGuide2"
                    app:layout_constraintTop_toBottomOf="@id/hGuide2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubtract"
                    style="@style/Widget.Calco.Key.Operator"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_subtract"
                    android:text="−"
                    app:layout_constraintBottom_toTopOf="@id/hGuide3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vGuide3"
                    app:layout_constraintTop_toBottomOf="@id/hGuide2" />

                <!-- Row 4: 4, 5, 6, + -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn4"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="4"
                    app:layout_constraintBottom_toTopOf="@id/hGuide4"
                    app:layout_constraintEnd_toStartOf="@id/vGuide1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/hGuide3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn5"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="5"
                    app:layout_constraintBottom_toTopOf="@id/hGuide4"
                    app:layout_constraintEnd_toStartOf="@id/vGuide2"
                    app:layout_constraintStart_toEndOf="@id/vGuide1"
                    app:layout_constraintTop_toBottomOf="@id/hGuide3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn6"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="6"
                    app:layout_constraintBottom_toTopOf="@id/hGuide4"
                    app:layout_constraintEnd_toStartOf="@id/vGuide3"
                    app:layout_constraintStart_toEndOf="@id/vGuide2"
                    app:layout_constraintTop_toBottomOf="@id/hGuide3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    style="@style/Widget.Calco.Key.Operator"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_add"
                    android:text="+"
                    app:layout_constraintBottom_toTopOf="@id/hGuide4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vGuide3"
                    app:layout_constraintTop_toBottomOf="@id/hGuide3" />

                <!-- Row 5: 1, 2, 3 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn1"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="1"
                    app:layout_constraintBottom_toTopOf="@id/hGuide5"
                    app:layout_constraintEnd_toStartOf="@id/vGuide1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/hGuide4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn2"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="2"
                    app:layout_constraintBottom_toTopOf="@id/hGuide5"
                    app:layout_constraintEnd_toStartOf="@id/vGuide2"
                    app:layout_constraintStart_toEndOf="@id/vGuide1"
                    app:layout_constraintTop_toBottomOf="@id/hGuide4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn3"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="3"
                    app:layout_constraintBottom_toTopOf="@id/hGuide5"
                    app:layout_constraintEnd_toStartOf="@id/vGuide3"
                    app:layout_constraintStart_toEndOf="@id/vGuide2"
                    app:layout_constraintTop_toBottomOf="@id/hGuide4" />

                <!-- Row 6: History List (≡), 0, . -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistory"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_history"
                    app:icon="@drawable/ic_history_list"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/key_digit_text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/vGuide1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/hGuide5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn0"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:text="0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/vGuide2"
                    app:layout_constraintStart_toEndOf="@id/vGuide1"
                    app:layout_constraintTop_toBottomOf="@id/hGuide5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDecimal"
                    style="@style/Widget.Calco.Key.Digit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_decimal"
                    android:text="."
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/vGuide3"
                    app:layout_constraintStart_toEndOf="@id/vGuide2"
                    app:layout_constraintTop_toBottomOf="@id/hGuide5" />

                <!-- Tall 2-Row Equals Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEquals"
                    style="@style/Widget.Calco.Key.Equals"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:contentDescription="@string/cd_equals"
                    android:text="="
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vGuide3"
                    app:layout_constraintTop_toBottomOf="@id/hGuide4" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- TAB 2: Unit Converter Workspace -->
        <include
            android:id="@+id/includeUnitConverter"
            layout="@layout/view_unit_converter" />

        <!-- TAB 3: Age Calculator Workspace -->
        <include
            android:id="@+id/includeAgeCalculator"
            layout="@layout/view_age_calculator" />
    </FrameLayout>
</LinearLayout>
